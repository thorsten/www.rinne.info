{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "indentWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "ignorePatterns": ["public", "node_modules", "static", "pnpm-lock.yaml", "*.html", "*.md", "*.yml", "*.yaml"]
}
